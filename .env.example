# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OneSignal integrations are intentionally disabled for now.

# Strix security scanner (local only; never commit a real key)
STRIX_LLM=openai/gpt-5
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional providers. Keep all secrets server-side.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
PAYMENT_PROVIDER_URL=
PAYMENT_WEBHOOK_SECRET=
ACCESS_CONTROL_URL=
ACCESS_CONTROL_API_KEY=
BARRIER_PROVIDER_URL=
BARRIER_PROVIDER_API_KEY=
