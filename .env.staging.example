# Staging uses a separate Supabase project and separate provider credentials.
NEXT_PUBLIC_APP_URL=https://staging.example.kz
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-staging-key

# AI is disabled until both values are configured on the server.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional delivery and building hardware providers.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
PAYMENT_PROVIDER_URL=
PAYMENT_WEBHOOK_SECRET=
ACCESS_CONTROL_URL=
ACCESS_CONTROL_API_KEY=
BARRIER_PROVIDER_URL=
BARRIER_PROVIDER_API_KEY=
